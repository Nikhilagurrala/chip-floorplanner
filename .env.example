# --- API KEYS ---
# Copy this file to .env and fill in your keys.

# Hugging Face Token (for Qwen, Llama-3, etc.)
HF_TOKEN=your_hf_token_here

# OpenAI API Key (for GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=your_openai_key_here

# Groq API Key (for lightning fast Llama-3/Mistral/Mixtral)
GROQ_API_KEY=your_groq_key_here

# --- ENVIRONMENT CONFIG ---
ENV_WS_URL=ws://127.0.0.1:7861/ws
BENCHMARK_LEVELS=easy,medium,hard
REPETITIONS=1
